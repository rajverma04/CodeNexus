{
  "title": "Express API Metrics",
  "tags": [
    "express",
    "nodejs",
    "api"
  ],
  "timezone": "browser",
  "schemaVersion": 30,
  "panels": [
    {
      "title": "Total Request Rate (req/sec)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count[1m])) by (method, path)",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "title": "Error Rate (5xx/sec)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"5..\"}[1m])) by (method, path)",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "title": "Average Response Time (seconds)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_sum[1m])) by (method, path) / sum(rate(http_request_duration_seconds_count[1m])) by (method, path)",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "title": "Requests by Status Code (req/sec)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count[1m])) by (status_code)",
          "legendFormat": "HTTP {{status_code}}"
        }
      ]
    }
  ]
}